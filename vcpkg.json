{
  "name": "hikari",
  "version-string": "1.0.0",
  "description": "Direct3D 11 MMD/MME runtime and Qt6 animation studio",
  "dependencies": [
    "joltphysics",
    "stb",
    {
      "name": "ffmpeg",
      "default-features": false,
      "features": [
        "avcodec",
        "avformat",
        "swresample"
      ]
    }
  ],
  "features": {
    "tests": {
      "description": "Build the Catch2 unit and integration tests",
      "dependencies": [
        "catch2"
      ]
    }
  },
  "default-features": []
}
