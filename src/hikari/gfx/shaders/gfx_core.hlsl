// Native Hikari graphics pipeline, phase 2.
// This file is compiled at runtime by ShaderLibrary. Keep it self-contained:
// the renderer concatenates no external includes.

cbuffer FrameParams : register(b0) {
    row_major float4x4 View;
    row_major float4x4 Projection;
    row_major float4x4 ViewProjection;
    row_major float4x4 InverseView;
    row_major float4x4 PrevViewProjection;
    float4 CameraPos;
    float4 SunDirection;
    float4 SunColor;
    float4 AmbientColor;
    float4 Params0; // near, far, exposure, time
    float4 Params1; // ortho, viewport width, viewport height, frame index
    float4 Params2; // projection 00, projection 11, ortho width, ortho height
    float4 BackgroundColor;
};

cbuffer MaterialParams : register(b1) {
    float4 BaseColor;
    float4 SpecularRoughness;
    float4 EmissiveMetallic;
    float4 CustomData; // customA, customB, visibility, packed shading model/flags
    float4 UvTransform; // scale xy, offset zw
};

StructuredBuffer<float4> BoneRows : register(t8);
Texture2D DiffuseMap : register(t8);
SamplerState LinearSampler : register(s0);

Texture2D GB0Tex : register(t0);
Texture2D GB1Tex : register(t1);
Texture2D GB2Tex : register(t2);
Texture2D GB3Tex : register(t3);
Texture2D GB4Tex : register(t4);
Texture2D DepthTex : register(t5);
Texture2D HdrTex : register(t6);
Texture2DArray<float> ShadowMapArray : register(t7);
Texture2D SkyVisibilityTex : register(t9);
Texture2D ShadowMaskTex : register(t10);
// Per-frame sun transmittance by altitude, generated by SunTransmittancePS.
Texture2D SunTransmittanceTex : register(t11);
Texture2D CloudNoiseTex : register(t12);
Texture2D MilkyWayTex : register(t13);
Texture2D MoonTex : register(t14);
// Sky captured for image based lighting: six faces at 128 or 256 pixels.
TextureCube SkyCubeTex : register(t15);
// Diffuse irradiance of the captured sky: nine coefficients with three floats
// each (l = 0, 1, 2), written by SkyShReduceCS.
StructuredBuffer<float> SkySh : register(t16);
RWStructuredBuffer<float> SkyShOut : register(u1);
// GGX prefiltered copy of the captured sky, one roughness step per mip level.
TextureCube SkyPrefilterTex : register(t17);
Texture2D CloudCoverTex : register(t18);
Texture2D CloudDetailTex : register(t19);

SamplerState PointSampler : register(s1);
SamplerComparisonState ShadowCmpSampler : register(s2);
SamplerState SkySampler : register(s3);

cbuffer ShadowParams : register(b2) {
    row_major float4x4 LightViewProjection[4];
    row_major float4x4 SkyVisibilityMatrix;
    float4 CascadeSplits;      // far linear view depth per cascade
    float4 CascadeTexelWorld;  // world size of one shadow texel per cascade
    float4 CascadeLightRange;  // orthographic depth range per cascade
    float4 ShadowParams0;      // x depth bias, y normal bias (texels), z pcss, w blur radius
    float4 ShadowParams1;      // x light radius (radians), y contact length, z contact thickness, w ssgs length
    float4 ShadowParams2;      // x ssgs thickness, y sky height bias, z cascade count, w sky texel uv
    float4 ShadowParams3;      // x sky visibility mode, y unused, z contact steps, w ssgs steps
};

cbuffer ShadowDrawParams : register(b3) {
    row_major float4x4 ShadowDrawMatrix;
    float4 ShadowDrawParams;
};

cbuffer SkyParams : register(b4) {
    float4 SkyParams0; // x turbidity, y ozone, z sun radiance, w sun angular radius
    float4 SkyParams1; // x primary samples, y mie anisotropy, z observer height, w time seconds
    float4 SkyParams2; // x cloud coverage, y cloud density, z cloud speed, w turbulence
    float4 SkyParams3; // x moon phase, y moon intensity, z star brightness, w milky way
    float4 SkyParams4; // x prefilter roughness, y prefilter samples, z prefilter mips, w unused
};

cbuffer IblParams : register(b5) {
    float4 IblParams0; // x intensity, y last prefilter mip, z rotation radians, w sky ambient strength
};

cbuffer AoSsrGiParams : register(b6) {
    float4 AoParams0;  // x radius, y intensity, z blur radius, w ao type
    float4 AoParams1;  // x slices, y steps, z samples, w sky visibility
    float4 SsrParams0; // x max steps, y max distance, z thickness, w fade start
    float4 SsrParams1; // x debug mode, y debug enable, z step scale, w roughness
    float4 GiParams0;  // x enable, y ray count, z steps, w filter radius
    float4 GiParams1;  // x prefilter radius, y sample radius, z thickness, w bounce weight
    float4 GiParams2;  // x il amount, y ao amount, z specular gi, w sensitivity
    float4 VxgiParams0; // center.xyz, extent
    float4 VxgiParams1; // voxel_size, inv_range, grid_dim, num_cones
};

// Phase 5 half-resolution chains. A register is reused across passes because
// each pass has its own shader and bindings: t21 is the raw SSR trace while the
// resolve runs and the resolved colour when lighting reads it.
Texture2D AoBlurTex : register(t20);
Texture2D SsrTex : register(t21);
Texture2D GiTex : register(t22);
Texture3D<float4> VxgiRadianceLightingTex : register(t23);
Texture2D SsrBlur0Tex : register(t23);
Texture2D BlurSourceTex : register(t24);
// Hierarchical Z-Buffer depth pyramid covering all mip levels, used by the Hi-Z SSR trace.
Texture2D HzbTex : register(t25);
RWTexture2D<float4> GiOutUAV : register(u0);
RWTexture2D<float4> GiHistoryUAV : register(u2);

// VXGI 3D volume targets
RWTexture3D<uint> VxgiVolumeUav : register(u0);
Texture3D<uint> VxgiVolumeTex : register(t24);
Texture3D<float4> VxgiRadianceTex : register(t25);
RWTexture3D<float4> VxgiRadianceMipUav : register(u0);

